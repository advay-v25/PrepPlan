# Public, browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional comma-separated exact hostnames for loading Next dev assets from other devices.
ROADMAP_DEV_HOSTS=
# Use the HTTPS origin in production. Google and Turnstile are opt-in.
NEXT_PUBLIC_GOOGLE_SIGN_IN=0
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Google OAuth credentials, Turnstile secret, and auth SMTP belong in Supabase Auth.

# Server-only keys — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Independent 32-byte random secret recommended. Without it, the service role key signs short-lived recovery intents and hashes quota identities.
APP_SECURITY_SECRET=
HEALTHCHECK_SECRET=
CRON_SECRET=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
RESEND_API_KEY=
RESEND_FROM_EMAIL=Roadmap <account@example.com>
# Supabase verification/reset emails also require SMTP or an Auth email hook configured there.

# Migration CLI only. These are not needed by the running web app.
# --env=local reads only .env.local and MUST target loopback Postgres.
MIGRATION_DATABASE_URL=
MIGRATION_EXPECTED_DATABASE=
# --env=staging / --env=production read .env.staging.local / .env.production.local
# respectively, including their own NEXT_PUBLIC_SUPABASE_URL and DB password.
MIGRATION_EXPECTED_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Optional trusted CA bundle; TLS certificate verification is always enabled remotely.
MIGRATION_SSL_CA_FILE=
# Hosted verification scripts require this explicit disposable-project binding.
E2E_CONFIRMED_DISPOSABLE_PROJECT_REF=

# Optional telemetry after consent and retention rules are defined
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
