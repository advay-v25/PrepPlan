    {
      "id": "tutor-1",
      "category": "tutoring",
      "message": "Teach me the entire FSA chapter",
      "expect": {
        "intent": "teach",
        "noProposal": true,
        "reply": [
          "does not teach chapters",
          "own materials"
        ],
        "replyForbids": [
          "the formula is",
          "step 1"
        ]
      }
    },
    {
      "id": "tutor-2",
      "category": "tutoring",
      "message": "Teach me this chapter.",
